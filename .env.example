# Copy to .env and fill in.
UI_PASSWORD=change-me
HUB_PORT=3870
# Dev-server previews (Preview button) are served on this separate port, so previewed pages are a different
# browser origin and can't call the Agent Hub API. Publish it the same way as HUB_PORT (LAN/Tailscale only).
HUB_PREVIEW_PORT=3871
# Optional: the address browsers should use for previews, e.g. https://agents-preview.your-tailnet.ts.net
# PREVIEW_PUBLIC_URL=
# Legacy: serve previews on the main port again. Previewed pages can then use the Agent Hub API with your session.
# PREVIEW_SAME_ORIGIN=false
# Set to true behind a reverse proxy that sets X-Forwarded-For, so sign-in rate limiting is per client.
# TRUST_PROXY=false
TZ=America/Los_Angeles
# Container image (defaults to prebuilt GHCR image; override to pin a tag/sha)
# AGENT_HUB_IMAGE=ghcr.io/rpeters1430/ai-agent:latest
PUID=1000
PGID=10
# Passwordless sudo for the `dev` user inside the container. Off by default: automations run agents unattended
# with your GitHub credentials, so keep root out of their reach unless you need it (e.g. agents installing apt packages).
ALLOW_SUDO=false
# Local build-only options (used with docker-compose.build.yaml):
# Set to true to bake Kodi + kodi-inputstream-adaptive into the image (for headless Kodi E2E)
INSTALL_KODI=false
# Optional space-separated Debian apt packages to bake into the image on build
EXTRA_APT_PACKAGES=

# GitHub token. Leave empty to use `gh auth login` from the UI. If you use automations, prefer a fine-grained token
# limited to the repos you watch, with Contents, Issues and Pull requests read/write (plus Checks read for CI fixes).
GITHUB_TOKEN=
GIT_USER_NAME=
GIT_USER_EMAIL=

# Optional - each CLI can also be signed in interactively or configured in System → API Keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=

# Ollama on another machine, e.g. http://192.168.1.50:11434 (can also be set in the UI)
OLLAMA_URL=
